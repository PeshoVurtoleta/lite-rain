{
  "name": "@zakkster/lite-color",
  "author": "Zahary Shinikchiev <shinikchiev@yahoo.com>",
  "version": "2.1.0",
  "description": "OKLCH color interpolation, multi-stop gradients, LUT baking, RGB bridges, sRGB gamut clamping, and CSS formatting for games and animations.",
  "type": "module",
  "main": "./Color.js",
  "module": "./Color.js",
  "types": "./Color.d.ts",
  "exports": {
    ".": {
      "types": "./Color.d.ts",
      "node": "./Color.js",
      "import": "./Color.js",
      "default": "./Color.js"
    }
  },
  "files": [
    "Color.js",
    "Color.d.ts",
    "llms.txt",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test 'test/**/*.test.mjs'",
    "test:watch": "node --test --watch 'test/**/*.test.mjs'",
    "torture": "node --expose-gc test/torture.mjs",
    "verify": "npm test && npm run torture"
  },
  "devDependencies": {
    "@zakkster/lite-gc-profiler": "^1.11.0",
    "@zakkster/lite-leak": "^1.8.0"
  },
  "license": "MIT",
  "homepage": "https://github.com/PeshoVurtoleta/lite-color#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PeshoVurtoleta/lite-color.git"
  },
  "bugs": {
    "url": "https://github.com/PeshoVurtoleta/lite-color/issues",
    "email": "shinikchiev@yahoo.com"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/PeshoVurtoleta"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "oklch",
    "color",
    "interpolation",
    "gradient",
    "lerp",
    "game",
    "css",
    "hsl",
    "lut",
    "rgb",
    "baking",
    "webgl",
    "canvas",
    "gamut",
    "srgb",
    "zero-gc"
  ],
  "sideEffects": false
}
