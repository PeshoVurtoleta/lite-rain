{
  "name": "@zakkster/lite-cleanup",
  "version": "1.1.0",
  "description": "Zero-GC FinalizationRegistry helper. Shared disposal registry with unregister semantics, tag-based collection reporting, and error routing.",
  "type": "module",
  "main": "./Cleanup.js",
  "module": "./Cleanup.js",
  "types": "./Cleanup.d.ts",
  "exports": {
    ".": {
      "types": "./Cleanup.d.ts",
      "node": "./Cleanup.js",
      "import": "./Cleanup.js",
      "default": "./Cleanup.js"
    }
  },
  "files": [
    "Cleanup.js",
    "Cleanup.d.ts",
    "CHANGELOG.md",
    "llms.txt",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "node --test --test-reporter=spec",
    "test:gc": "node --expose-gc --test --test-reporter=spec"
  },
  "keywords": [
    "finalization-registry",
    "cleanup",
    "disposal",
    "weak-references",
    "zero-gc",
    "lite-signal",
    "zakkster"
  ],
  "author": "Zahary Shinikchiev <shinikchiev@yahoo.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PeshoVurtoleta/lite-cleanup.git"
  },
  "bugs": {
    "url": "https://github.com/PeshoVurtoleta/lite-cleanup/issues"
  },
  "homepage": "https://github.com/PeshoVurtoleta/lite-cleanup#readme",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/PeshoVurtoleta"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
